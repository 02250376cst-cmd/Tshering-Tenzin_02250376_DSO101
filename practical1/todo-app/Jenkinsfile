pipeline { 
    agent any 
    tools { 
        nodejs 'NodeJS'   // Must match the name you configured in Jenkins
    } 
 
    stages { 
        // Stage 1: Checkout Code 
        stage('Checkout') { 
            steps { 
                git branch: 'main', 
                    url: 'https://github.com/02250376cst-cmd.git',
                    credentialsId: 'github-creds'
            } 
        } 
 
        stage('Install') { 
            steps { 
                bat 'npm install'
            } 
        } 

        // Stage 3: Build (if applicable, e.g., for React/TypeScript) 
        stage('Build') { 
            steps { 
                bat 'npm run build'
            } 
        } 

        // Stage 4: Run Unit Tests 
        stage('Test') { 
            steps { 
                bat 'npm test'   // Runs "test" script (Jest/Mocha) 
            } 
            post { 
                always { 
                    junit 'junit.xml'
                } 
            } 
        } 

        // Stage 5: Deploy (Docker Example) 
        stage('Deploy') { 
            steps { 
                script { 
                    // Build Docker image 
                    docker.build('tsheringtenzin/node-app:latest')

                    // Push to Docker Hub (requires credentials) 
                    docker.withRegistry('https://registry.hub.docker.com', 'docker-hub-creds') { 
                        docker.image('tsheringtenzin/node-app:latest').push() 
                    } 
                } 
            } 
        } 
    } 
}
