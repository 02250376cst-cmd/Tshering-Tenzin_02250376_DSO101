pipeline {
    agent any

    tools {
        nodejs 'NodeJS'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Backend - Install') {
            steps {
                dir('practical1/todo-app/backend') {
                    bat 'npm install'
                }
            }
        }

        stage('Backend - Build') {
            steps {
                dir('practical1/todo-app/backend') {
                    bat 'npm run build || echo "No build script"'
                }
            }
        }

        stage('Backend - Test') {
            steps {
                dir('practical1/todo-app/backend') {
                    bat 'npm test'
                }
            }
            post {
                always {
                    junit 'practical1/todo-app/backend/junit.xml'
                }
            }
        }

        stage('Frontend - Install & Build') {
            steps {
                dir('practical1/todo-app/frontend') {
                    bat 'npm install'
                    bat 'npm run build'
                }
            }
        }

        stage('Deploy Backend Image') {
            steps {
                script {
                    withEnv(['DOCKER_CLIENT_TIMEOUT=120', 'COMPOSE_HTTP_TIMEOUT=120']) {
                        dir('practical1/todo-app/backend') {
                            docker.build('tsheringtenzin/todo-backend:latest')
                            docker.withRegistry('https://registry.hub.docker.com', 'docker-hub-creds') {
                                docker.image('tsheringtenzin/todo-backend:latest').push()
                            }
                        }
                    }
                }
            }
        }
    }
}