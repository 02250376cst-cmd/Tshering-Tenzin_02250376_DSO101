pipeline { 
    agent any 
    tools { 
        nodejs 'NodeJS'   // Must match the name you configured in Jenkins
    } 

    stages { 
        // Stage 1: Checkout Code 
        stage('Checkout') { 
            steps { 
                git branch: 'main', 
                    url: 'https://github.com/02250376cst-cmd/Tshering-Tenzin_02250376_DSO101_A1.git',
                    credentialsId: 'github-creds'
            } 
        } 

        // Stage 2: Backend Install & Build
        stage('Backend - Install') { 
            steps { 
                dir('practical1/todo-app/backend') {
                    bat 'npm install'
                }
            } 
        } 

        stage('Backend - Build') { 
            steps { 
                dir('practical1/todo-app/backend') {
                    bat 'npm run build'
                }
            } 
        } 

        stage('Backend - Test') { 
            steps { 
                dir('practical1/todo-app/backend') {
                    bat 'npm test'
                }
            } 
            post { 
                always { 
                    junit 'practical1/todo-app/backend/junit.xml'
                } 
            } 
        } 

        // Stage 3: Frontend Install & Build
        stage('Frontend - Install') { 
            steps { 
                dir('practical1/todo-app/frontend') {
                    bat 'npm install'
                }
            } 
        } 

        stage('Frontend - Build') { 
            steps { 
                dir('practical1/todo-app/frontend') {
                    bat 'npm run build'
                }
            } 
        } 

        stage('Frontend - Test') { 
            steps { 
                dir('practical1/todo-app/frontend') {
                    bat 'npm test'
                }
            } 
            post { 
                always { 
                    junit 'practical1/todo-app/frontend/junit.xml'
                } 
            } 
        } 

        // Stage 4: Deploy (Docker Example)
        stage('Deploy') { 
            steps { 
                script { 
                    // Build Docker images for both backend and frontend
                    dir('practical1/todo-app/backend') {
                        docker.build('tsheringtenzin/todo-backend:latest')
                    }
                    dir('practical1/todo-app/frontend') {
                        docker.build('tsheringtenzin/todo-frontend:latest')
                    }

                    // Push both images to Docker Hub
                    docker.withRegistry('https://registry.hub.docker.com', 'docker-hub-creds') { 
                        docker.image('tsheringtenzin/todo-backend:latest').push() 
                        docker.image('tsheringtenzin/todo-frontend:latest').push() 
                    } 
                } 
            } 
        } 
    } 
}
